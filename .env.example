# Copy to ".env" and fill in. The API server loads this automatically via
# python-dotenv if it's installed.

# Which LLM provider brain.py uses — "anthropic" (default) or "groq".
LLM_PROVIDER=anthropic

# Anthropic-compatible endpoint (e.g. a local opencode proxy fronting a
# Claude subscription, or https://api.anthropic.com with a real API key).
# The SDK also reads these two directly from the env.
ANTHROPIC_API_KEY=x
ANTHROPIC_BASE_URL=https://api.anthropic.com
PA_MODEL=claude-sonnet-5

# Groq (only used when LLM_PROVIDER=groq) — get a key at console.groq.com.
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=openai/gpt-oss-120b

# JWT signing secret for the API server (api/). Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
MNEMO_JWT_SECRET=change-me-to-a-random-32+-byte-secret
