# Copy to ".env" and fill in. Both web.py and pa.py load this automatically
# via python-dotenv if it's installed.

# Anthropic-compatible endpoint (e.g. a local opencode proxy fronting a
# Claude subscription). The SDK also reads these two directly from the env.
ANTHROPIC_API_KEY=x
ANTHROPIC_BASE_URL=http://127.0.0.1:3456
PA_MODEL=claude-opus-4-8

# Telegram frontend (pa.py only)
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here

# Web frontend (web.py only) — all optional, shown with their defaults
PA_WEB_USER=web-rohith
PA_TZ=Asia/Kolkata
PA_WEB_PORT=8000
